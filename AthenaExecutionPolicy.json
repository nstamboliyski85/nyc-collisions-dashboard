{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadGlueCatalogMetadata",
            "Effect": "Allow",
            "Action": [
                "glue:GetDatabase",
                "glue:GetTable",
                "glue:GetPartitions"
            ],
            "Resource": [
                "arn:aws:iam::*:catalog",
                "arn:aws:glue:*:*:database/nyc_collisions_db",
                "arn:aws:glue:*:*:table/nyc_collisions_db/*"
            ]
        },
        {
            "Sid": "ReadDeltaLakeFiles",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::nyc-collisions-analytics-lake",
                "arn:aws:s3:::nyc-collisions-analytics-lake/*"
            ]
        },
        {
            "Sid": "ManageQueryScratchpadSpace",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::aws-athena-query-results-nyc-collisions",
                "arn:aws:s3:::aws-athena-query-results-nyc-collisions/*"
            ]
        }
    ]
}